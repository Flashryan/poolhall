{
    "name": "poolhall/poolhall-integration",
    "description": "Poolhall Recruitment integration plugin: jobs, Giig sync, applications, reviews, schema, admin health and candidate accounts.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Poolhall\\Integration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Poolhall\\Integration\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    }
}
